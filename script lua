local player = game.Players.LocalPlayer
player.Character.ChildAdded:Connect(function(t)
    if t:IsA("Tool") then
        task.wait(0.1)
        for _, v in pairs(t:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Color = math.random(1,2) == 1 and Color3.fromRGB(240,240,240) or Color3.fromRGB(20,20,20)
            elseif v:IsA("Trail") or v:IsA("Beam") or v:IsA("ParticleEmitter") then
                v.Color = ColorSequence.new(Color3.fromRGB(255,255,255))
            end
        end
    end
end)
